{
  // Repo tier-2 devbox packages (PRD #18 M5). ONLY the `packages` field is read by
  // the worker (agent/src/repo-tools.ts extractRepoDevboxPackages) — and ONLY when the
  // repo owner has enabled `repo_devbox_opt_in` AND each package is on the admin
  // tool_allowlist. init_hook/scripts/env/flakes here are NEVER executed by a run.
  //
  // ruby: this repo ships a Homebrew formula (Formula/uzi-cli.rb); without ruby a run
  // editing it can't even `ruby -c` syntax-check it before shipping (judge rec, run
  // e2d7427b). ruby is genuinely repo-specific (only formula-shipping repos need it),
  // so it lives here as tier-2 rather than in the baked worker image.
  //
  // openssl: this repo's e2e harness (e2e/run-e2e.sh) generates a self-signed cert for
  // the forge-fake step; without openssl a run touching e2e can only `bash -n` the
  // scenario, not execute it (judge rec, run dd06c0ed). Left UNPINNED (bare) — the
  // openssl CLI's patch version is irrelevant to `req`/`rand`, unlike ruby's
  // version-sensitive formula syntax; the admin tool_allowlist entry is bare too, so a
  // pinned `openssl@x` here would be REJECTED (toolprofile.Allowed requires exact
  // version match when the rule pins). Repo-specific (only e2e-with-TLS repos need it),
  // so tier-2, not the baked image.
  "packages": [
    "ruby@3.3",
    "openssl"
  ]
}
