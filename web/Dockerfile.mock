# syntax=docker/dockerfile:1
# MOCK build of the uzi SPA: the entire app runs on in-browser demo data
# (VITE_UZI_MOCK=1) and is served as pure static files — no api service, no
# proxy, no backend anywhere. Build context is the REPO ROOT (same as
# web/Dockerfile) so the in-app docs viewer can bundle docs/ as a sibling of
# web/.
#
#   docker build -f web/Dockerfile.mock -t uzi-ux-multica .
#   docker run -d --name uzi-ux-multica -p 127.0.0.1:8081:8080 uzi-ux-multica

# --- build stage ---
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS build
WORKDIR /app/web

COPY web/package.json web/package-lock.json ./
RUN npm ci

COPY web/ ./
COPY docs/ /app/docs/
ENV VITE_UZI_MOCK=1
RUN npm run build

# --- runtime stage ---
# nginx-unprivileged runs as a non-root user (uid 101) and listens on 8080.
FROM nginxinc/nginx-unprivileged:1.27-alpine@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0
COPY web/nginx.mock.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web/dist /usr/share/nginx/html
EXPOSE 8080
