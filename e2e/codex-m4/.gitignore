#                         nothing lands here.
#   .evidence/          : the per-run executed-test evidence JSONL the conformance tests
#                         append to and run-completeness.ts reads (wired via CODEX_M4_EVIDENCE).
*.log
gate-log.*
.codex-cache/
.evidence/
