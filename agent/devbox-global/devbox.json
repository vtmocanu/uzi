{
  // Pinned devbox GLOBAL manifest for the default worker toolchain (PRD #83 M1, Q2).
  //
  // go + python3 + pip are the owner's "the default worker should have docker/python/go
  // available" set. They are delivered through the ONE nix/devbox provisioning path
  // (PRD #18 — no second apk package path, no version drift), realized into the baked
  // image /nix at BUILD time via `devbox global install` so first use is instant instead
  // of paying the cold-start closure fetch. Each template Dockerfile copies this file
  // (agent/devbox-global/devbox.json) into devbox's global config dir and installs it
  // (base + jvm, in lockstep — jvm is NOT `FROM base`). It lives OUTSIDE agent/templates/
  // because that dir is one-directory-per-worker-image; this is shared build config, not
  // a template.
  //
  // devbox.json is parsed as HuJSON, so these `//` comments are valid.
  //
  // NOTE (pinning): the sibling `devbox.lock` pins the nixpkgs revision to an exact
  // resolved store path (generated by the tester's live arm64 build), so go/python/pip do
  // NOT drift per rebuild. Each Dockerfile COPYs the lock in BEFORE `devbox global install`
  // — without that COPY the image never sees it and the pin would float. Bump both the
  // manifest and the lock together when upgrading the toolchain.
  //
  // `pip` is nixpkgs `python3Packages.pip` (there is no top-level `pip` attr); the tester
  // confirms `pip`/`python3`/`go` all resolve on the agent PATH of the built image (Q-C).
  //
  // `gcc` completes the go/python3 toolchains rather than being a repo-specific extra:
  // `go test -race` and cgo need a C compiler/linker (this repo's own store integration
  // tests run `-race`), and python C-extension wheels need one too. Delivered through the
  // SAME nix/devbox path as go so cgo links against the matching toolchain (an apk/musl
  // gcc would mismatch nix-glibc go). Validate `cgo`/`-race` in the built image.
  "packages": [
    "go",
    "gcc",
    "python3",
    "python3Packages.pip"
  ]
}
