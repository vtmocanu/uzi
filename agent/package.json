{
  "name": "uzi-agent",
  "version": "0.1.0-m4",
  "private": true,
  "type": "module",
  "description": "uzi worker: outbound-only agent runtime that claims runs, works in an isolated git worktree, and reports back to the uzi API.",
  "main": "src/main.ts",
  "scripts": {
    "start": "tsx src/main.ts",
    "eval:pr-description": "tsx src/pr-description-eval-cli.ts",
    "lint": "oxlint --config .oxlintrc.json -D correctness --report-unused-disable-directives-severity=error src test",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./test/setup/hermetic-proc.ts --test ${UZI_AGENT_TEST_CONCURRENCY:+--test-concurrency=$UZI_AGENT_TEST_CONCURRENCY} ${UZI_AGENT_TEST_SHARD:+--test-shard=$UZI_AGENT_TEST_SHARD} ${UZI_AGENT_TEST_JUNIT:+--test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=$UZI_AGENT_TEST_JUNIT} --test-timeout=120000 test/*.test.ts",
    "test:cross-check-confinement": "task --dir .. test:cross-check-confinement",
    "deps-check": "npm ls --depth=0",
    "audit": "npm audit --audit-level=high --include=dev"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "agent-browser": "0.38.1",
    "smol-toml": "1.9.0",
    "tsx": "^4.19.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "knip": "6.38.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.0"
  },
  "overrides": {
    "fast-uri": "^4.0.0",
    "qs": "^6.16.0",
    "hono": "^4.13.5"
  }
}
