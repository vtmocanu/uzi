{
  "name": "uzi-agent",
  "version": "0.1.0-m4",
  "private": true,
  "type": "module",
  "description": "uzi worker: outbound-only agent runtime that claims runs, works in an isolated git worktree, and reports back to the uzi API.",
  "main": "src/main.ts",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=30000 test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.219",
    "agent-browser": "0.32.3",
    "tsx": "^4.19.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
