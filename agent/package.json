{
  "name": "uzi-agent",
  "version": "0.1.0-m2",
  "private": true,
  "type": "module",
  "description": "uzi worker: outbound-only agent runtime that claims runs, works in an isolated git worktree, and reports back to the uzi API.",
  "main": "src/main.ts",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
