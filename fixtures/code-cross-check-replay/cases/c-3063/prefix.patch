diff --git a/api/internal/handler/findings_send_to_uzi_livedb_test.go b/api/internal/handler/findings_send_to_uzi_livedb_test.go
new file mode 100644
index 00000000..01afc8db
--- /dev/null
+++ b/api/internal/handler/findings_send_to_uzi_livedb_test.go
@@ -0,0 +1,196 @@
+package handler
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/vtmocanu/uzi/api/internal/settings"
+	"github.com/vtmocanu/uzi/api/internal/store"
+	"github.com/vtmocanu/uzi/api/internal/workersvc"
+)
+
+// Bodies deliberately use raw JSON rather than the new DTO fields, so this file and the
+// fake capture changes can also exercise request acceptance against the pinned baseline.
+type findingSendCase struct {
+	name           string
+	body           string
+	rows           []store.AppSetting
+	storeErr       error
+	ensureFail     bool
+	wantStatus     int
+	groupStatus    int
+	filed, ensured []string
+}
+
+func findingSendCases() []findingSendCase {
+	marker := findingTestMarker
+	defaults := []string{marker, "uzi", "autopilot"}
+	custom := []store.AppSetting{
+		{Key: settings.KeyFindingLabel, Value: "reported"},
+		{Key: settings.KeyUziLabel, Value: "eligible"},
+		{Key: settings.KeyAutopilotLabel, Value: "hands-off"},
+	}
+	capped := []string{marker, "clean", strings.Repeat("a", 64)}
+	raw := []string{"", "bad,separator", "clean\u0001", "clean", strings.Repeat("a", 80)}
+	for i := 0; i < workersvc.MaxProposalLabels; i++ {
+		name := fmt.Sprintf("explicit-%02d", i)
+		raw = append(raw, name)
+		if len(capped) < workersvc.MaxProposalLabels {
+			capped = append(capped, name)
+		}
+	}
+	labels, _ := json.Marshal(raw)
+	return []findingSendCase{
+		{name: "absent", body: "{}", filed: []string{marker}, ensured: []string{marker}},
+		{name: "false", body: `{"send_to_uzi":false}`, filed: []string{marker}, ensured: []string{marker}},
+		{name: "false explicit run labels", body: `{"send_to_uzi":false,"labels":["uzi","autopilot","chosen"]}`, filed: []string{marker, "uzi", "autopilot", "chosen"}, ensured: []string{marker}},
+		{name: "true missing rows", body: `{"send_to_uzi":true}`, filed: defaults, ensured: defaults},
+		{name: "custom settings", body: `{"send_to_uzi":true,"labels":["chosen"]}`, rows: custom,
+			filed: []string{"reported", "chosen", "eligible", "hands-off"}, ensured: []string{"reported", "eligible", "hands-off"}},
+		{name: "explicit defaults", body: `{"send_to_uzi":true}`, rows: []store.AppSetting{
+			{Key: settings.KeyUziLabel, Value: "uzi"}, {Key: settings.KeyAutopilotLabel, Value: "autopilot"}},
+			filed: defaults, ensured: defaults},
+		{name: "exact explicit collisions", body: `{"send_to_uzi":true,"labels":["autopilot","uzi","agent-found","Uzi","uzi"]}`,
+			filed: []string{marker, "autopilot", "uzi", "Uzi"}, ensured: defaults},
+		// These rows bypass admin validation intentionally: legacy coincident settings must
+		// deduplicate even though ValidateMerged rejects new eligibility collisions.
+		{name: "legacy all coincident", body: `{"send_to_uzi":true}`, rows: []store.AppSetting{
+			{Key: settings.KeyUziLabel, Value: marker}, {Key: settings.KeyAutopilotLabel, Value: marker}},
+			filed: []string{marker}, ensured: []string{marker}},
+		{name: "legacy run labels coincident", body: `{"send_to_uzi":true}`, rows: []store.AppSetting{
+			{Key: settings.KeyUziLabel, Value: "run"}, {Key: settings.KeyAutopilotLabel, Value: "run"}},
+			filed: []string{marker, "run"}, ensured: []string{marker, "run"}},
+		{name: "sanitization and cap", body: `{"send_to_uzi":true,"labels":` + string(labels) + "}",
+			filed: append(slices.Clone(capped), "uzi", "autopilot"), ensured: defaults},
+		{name: "ensure failure", body: `{"send_to_uzi":true}`, ensureFail: true, wantStatus: http.StatusBadGateway, ensured: []string{marker}},
+		{name: "cold settings error", body: `{"send_to_uzi":true}`, storeErr: errors.New("settings unavailable"),
+			groupStatus: http.StatusInternalServerError, filed: defaults, ensured: defaults},
+		{name: "false cold settings error", body: `{"send_to_uzi":false}`, storeErr: errors.New("settings unavailable"),
+			groupStatus: http.StatusInternalServerError, filed: []string{marker}, ensured: []string{marker}},
+	}
+}
+
+func TestFileFindingSendToUziLiveDB(t *testing.T) {
+	for _, tc := range findingSendCases() {
+		t.Run(tc.name, func(t *testing.T) {
+			h, pool, q, box, fs := fileFindingLiveDB(t)
+			h.settings = settings.New(&settingsStore{rows: tc.rows, err: tc.storeErr}, time.Minute)
+			f := seedFindingFileFixture(context.Background(), t, pool, q, box, fs.server.URL)
+			fs.ensureFail = tc.ensureFail
+			req := fileFindingReq(f.owner, f.finding.ID, nil)
+			req.Body = io.NopCloser(strings.NewReader(tc.body))
+			rr := httptest.NewRecorder()
+			h.FileFinding(rr, req)
+			want := tc.wantStatus
+			if want == 0 {
+				want = http.StatusCreated
+			}
+			if rr.Code != want {
+				t.Fatalf("status=%d want=%d body=%s", rr.Code, want, rr.Body.String())
+			}
+			fs.mu.Lock()
+			ensured := slices.Clone(fs.ensured)
+			seqs := slices.Clone(fs.ensureSeqs)
+			issueSeq := fs.firstIssueAt
+			creates := slices.Clone(fs.creates)
+			fs.mu.Unlock()
+			if !slices.Equal(ensured, tc.ensured) {
+				t.Errorf("ensured=%v want=%v", ensured, tc.ensured)
+			}
+			if tc.ensureFail {
+				if len(creates) != 0 {
+					t.Fatal("ensure failure reached CreateIssue")
+				}
+				if status, _ := dispositionStatus(context.Background(), t, pool, f.owner.ID, f.repoID, f.location); status != "open" {
+					t.Fatalf("claim not reverted: %s", status)
+				}
+				return
+			}
+			if len(creates) != 1 {
+				t.Fatalf("creates=%d want=1", len(creates))
+			}
+			if !slices.Equal(creates[0].Labels, tc.filed) {
+				t.Errorf("filed=%v want=%v", creates[0].Labels, tc.filed)
+			}
+			for _, seq := range seqs {
+				if seq <= 0 || seq >= issueSeq {
+					t.Errorf("ensure sequence=%d create=%d", seq, issueSeq)
+				}
+			}
+		})
+	}
+}
+
+func TestFileFindingGroupSendToUziLiveDB(t *testing.T) {
+	for _, tc := range findingSendCases() {
+		t.Run(tc.name, func(t *testing.T) {
+			e := newFGEnv(t, nil)
+			e.h.settings = settings.New(&settingsStore{rows: tc.rows, err: tc.storeErr}, time.Minute)
+			members := e.members(2)
+			// Add ids to a raw JSON body without relying on FindingGroupFileRequest.
+			ids, _ := json.Marshal(fgIDs(members...))
+			body := `{"ids":` + string(ids) + "}"
+			if tc.body != "{}" {
+				body = `{"ids":` + string(ids) + "," + strings.TrimPrefix(tc.body, "{")
+			}
+			e.fake.ensureErr = nil
+			if tc.ensureFail {
+				e.fake.ensureErr = errors.New("ensure refused")
+			}
+			rr := httptest.NewRecorder()
+			e.h.FileFindingGroup(rr, fgRequest(e.owner, http.MethodPost, "/x", json.RawMessage(body), nil))
+			want := tc.wantStatus
+			if want == 0 {
+				want = http.StatusCreated
+			}
+			if tc.groupStatus != 0 {
+				want = tc.groupStatus
+			}
+			if rr.Code != want {
+				t.Fatalf("status=%d want=%d body=%s", rr.Code, want, rr.Body.String())
+			}
+			e.fake.mu.Lock()
+			ensured := slices.Clone(e.fake.ensured)
+			ensureSeq, createSeq := e.fake.ensureS, e.fake.createS
+			e.fake.mu.Unlock()
+			wantEnsured := tc.ensured
+			if tc.ensureFail {
+				wantEnsured = []string{findingTestMarker, "uzi", "autopilot"}
+			}
+			if tc.groupStatus != 0 {
+				wantEnsured = nil
+			}
+			if !slices.Equal(ensured, wantEnsured) {
+				t.Errorf("ensured=%v want=%v", ensured, wantEnsured)
+			}
+			if want != http.StatusCreated {
+				if e.fake.createCount() != 0 {
+					t.Fatal("failed request reached CreateIssue")
+				}
+				e.requireOpen(members...)
+				if n, _, err := store.FindingGroupPendingStats(e.ctx, e.pool, e.owner.ID); err != nil || n != 0 {
+					t.Fatalf("operation not released: pending=%d err=%v", n, err)
+				}
+				return
+			}
+			if e.fake.createCount() != 1 {
+				t.Fatalf("creates=%d want=1", e.fake.createCount())
+			}
+			if got := e.fake.create(0).Labels; !slices.Equal(got, tc.filed) {
+				t.Errorf("filed=%v want=%v", got, tc.filed)
+			}
+			if ensureSeq <= 0 || ensureSeq >= createSeq {
+				t.Errorf("ensure sequence=%d create=%d", ensureSeq, createSeq)
+			}
+		})
+	}
+}
diff --git a/api/internal/poller/autopilot_filed_test.go b/api/internal/poller/autopilot_filed_test.go
new file mode 100644
index 00000000..a3fd6f34
--- /dev/null
+++ b/api/internal/poller/autopilot_filed_test.go
@@ -0,0 +1,187 @@
+package poller
+
+import (
+	"context"
+	"errors"
+	"slices"
+	"strings"
+	"testing"
+
+	"github.com/vtmocanu/uzi/api/internal/forge"
+	"github.com/vtmocanu/uzi/api/internal/store"
+)
+
+// The candidate is already cached: these tests do not prove filing -> forge sync
+// -> cache creation. Handler writes use the repo-owner PAT, so event adder and
+// issue author can be that PAT's identity, not the user who clicked in the UI.
+type apFiledForge struct {
+	*apForge
+	labelWrites int
+}
+
+func (f *apFiledForge) UpdateIssueLabels(context.Context, int64, int64, []string, []string) error {
+	f.labelWrites++
+	return errors.New("unexpected issue label write")
+}
+
+func filedCandidate(author string) (*apStore, *apRuns, *apFiledForge) {
+	return &apStore{
+		candidates: []store.ListAutopilotCandidateIssuesRow{candIssue(7, author)},
+		cc:         ccOwner("alice", true, true),
+	}, &apRuns{}, &apFiledForge{apForge: &apForge{
+		issue: forge.Issue{
+			Description: "Fix the filed issue, preserving this description.",
+			Labels:      []string{"agent-found", "uzi", apLabel},
+		},
+	}}
+}
+
+func detectFiled(st *apStore, runs *apRuns, f *apFiledForge) {
+	NewAutopilot(st, runs, apLabeler{label: apLabel}).detect(context.Background(), repoRow(), f)
+}
+
+func assertFiledLabelsRetained(t *testing.T, f *apFiledForge) {
+	t.Helper()
+	if f.labelWrites != 0 || !slices.Equal(f.issue.Labels, []string{"agent-found", "uzi", apLabel}) {
+		t.Fatalf("filed eligibility changed: label writes=%d labels=%v", f.labelWrites, f.issue.Labels)
+	}
+}
+
+func assertFiledStart(t *testing.T, runs *apRuns, f *apFiledForge) {
+	t.Helper()
+	if len(runs.calls) != 1 {
+		t.Fatalf("CreateAutopilotRun calls = %+v, want one", runs.calls)
+	}
+	c := runs.calls[0]
+	if c.userID != apUserID || c.repoID != apRepoID || c.iid != 7 || c.desc != f.issue.Description {
+		t.Fatalf("run call = %+v, want owner/repo/issue and fresh description", c)
+	}
+}
+
+func TestAutopilotFiledLabelCandidates(t *testing.T) {
+	cases := []struct {
+		name, human, adder, author string
+		enabled                    bool
+		events                     []forge.LabelEvent
+		wantRun, wantComment       bool
+	}{
+		{name: "enabled owner adder", human: "alice", adder: "alice", author: "filing-bot", enabled: true, wantRun: true},
+		{name: "cached author fallback", human: "alice", adder: "repo-pat", author: "alice", enabled: true, wantRun: true},
+		{name: "disabled owner", human: "alice", adder: "alice", author: "alice", wantComment: true},
+		{name: "bot PAT is neither human adder nor author", human: "alice", adder: "repo-bot", author: "repo-bot", enabled: true, wantComment: true},
+		{name: "other actor and author", human: "alice", adder: "bob", author: "carol", enabled: true, wantComment: true},
+		{name: "empty declared human mapping", adder: "alice", author: "alice", enabled: true, wantComment: true},
+		{name: "no add event", human: "alice", author: "alice", enabled: true},
+		{name: "latest event removed", human: "alice", author: "alice", enabled: true, events: []forge.LabelEvent{addEvt(100, "alice"), remEvt(105, "alice")}},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			st, runs, f := filedCandidate(tc.author)
+			st.cc = ccOwner(tc.human, tc.enabled, true)
+			if tc.human == "" {
+				// The existing no-mapping test covers NULL; exercise a declared empty value here.
+				st.cc.HumanUsername.Valid = true
+			}
+			events := tc.events
+			if tc.adder != "" {
+				events = []forge.LabelEvent{addEvt(100, tc.adder)}
+			}
+			f.events = map[int64][]forge.LabelEvent{7: events}
+			// A fresh forge author must not replace the cached attribution input.
+			f.issue.Author = "fresh-unrelated-actor"
+			detectFiled(st, runs, f)
+			detectFiled(st, runs, f) // Same application is handled only once.
+
+			if tc.wantRun {
+				assertFiledStart(t, runs, f)
+			} else if len(runs.calls) != 0 {
+				t.Fatalf("unexpected run calls: %+v", runs.calls)
+			}
+			wantNotes := 0
+			if tc.wantComment {
+				wantNotes = 1
+			}
+			if len(f.noteAttempts) != wantNotes || len(f.notes) != wantNotes {
+				t.Fatalf("comment attempts=%+v successful=%+v, want %d", f.noteAttempts, f.notes, wantNotes)
+			}
+			if tc.wantComment {
+				note := f.noteAttempts[0]
+				if note.iid != 7 || !strings.Contains(note.body, "autopilot enabled is mapped") || !strings.Contains(note.body, "remove and re-add") {
+					t.Fatalf("missing consent explanation/retry instruction: %+v", note)
+				}
+			}
+			wantRecords := 0
+			if tc.wantRun || tc.wantComment {
+				wantRecords = 1
+			}
+			if len(st.upserts) != wantRecords {
+				t.Fatalf("trigger records=%+v, want %d", st.upserts, wantRecords)
+			}
+			if wantRecords != 0 {
+				got := lastUpsert(t, st)
+				if got.RepoID != apRepoID || got.IssueIid != 7 || got.LastEventID != 100 {
+					t.Fatalf("recorded transition = %+v", got)
+				}
+			}
+			assertFiledLabelsRetained(t, f)
+		})
+	}
+}
+
+func TestAutopilotFiledRefusalEnableReplayThenReAdd(t *testing.T) {
+	for _, failedPost := range []bool{false, true} {
+		name := "comment succeeds"
+		if failedPost {
+			name = "comment POST fails"
+		}
+		t.Run(name, func(t *testing.T) {
+			st, runs, f := filedCandidate("repo-bot")
+			st.cc.AutopilotEnabled = false
+			f.events = map[int64][]forge.LabelEvent{7: {addEvt(100, "alice")}}
+			var ops []string
+			st.ops, runs.ops, f.ops = &ops, &ops, &ops
+			if failedPost {
+				f.noteErr = errors.New("comment POST unavailable")
+			}
+
+			detectFiled(st, runs, f)
+			if len(runs.calls) != 0 || len(st.upserts) != 1 || lastUpsert(t, st).LastEventID != 100 ||
+				len(f.noteAttempts) != 1 || strings.Join(ops, ",") != "record,comment" {
+				t.Fatalf("refusal must record then attempt one comment: runs=%+v records=%+v attempts=%+v ops=%v", runs.calls, st.upserts, f.noteAttempts, ops)
+			}
+			if f.noteAttempts[0].iid != 7 || !strings.Contains(f.noteAttempts[0].body, "autopilot enabled is mapped") {
+				t.Fatalf("unexpected refusal: %+v", f.noteAttempts)
+			}
+			wantNotes := 1
+			if failedPost {
+				wantNotes = 0
+			}
+			if len(f.notes) != wantNotes {
+				t.Fatalf("successful comments=%+v, want %d", f.notes, wantNotes)
+			}
+			assertFiledLabelsRetained(t, f)
+
+			st.cc.AutopilotEnabled = true
+			f.noteErr = nil // A recovered POST must still never be retried.
+			detectFiled(st, runs, f)
+			if len(runs.calls) != 0 || len(st.upserts) != 1 || len(f.noteAttempts) != 1 || len(f.notes) != wantNotes {
+				t.Fatalf("enabling must not replay the refused application: runs=%+v records=%+v attempts=%+v notes=%+v", runs.calls, st.upserts, f.noteAttempts, f.notes)
+			}
+
+			f.events[7] = append(f.events[7], remEvt(105, "alice"))
+			detectFiled(st, runs, f)
+			if len(runs.calls) != 0 || len(st.upserts) != 1 || len(f.noteAttempts) != 1 {
+				t.Fatal("removal must not start, record or comment")
+			}
+			f.events[7] = append(f.events[7], addEvt(110, "alice"))
+			detectFiled(st, runs, f)
+			detectFiled(st, runs, f)
+			assertFiledStart(t, runs, f)
+			if len(st.upserts) != 2 || lastUpsert(t, st).LastEventID != 110 || len(f.noteAttempts) != 1 || len(f.notes) != wantNotes ||
+				strings.Join(ops, ",") != "record,comment,create,record" {
+				t.Fatalf("re-add must start exactly once: records=%+v attempts=%+v notes=%+v ops=%v", st.upserts, f.noteAttempts, f.notes, ops)
+			}
+			assertFiledLabelsRetained(t, f)
+		})
+	}
+}
