    {
      "name": "multi-lane",
      "now": "2026-09-19T12:00:00Z",
      "milestones": [{"id": "m2", "title": "Rate limiter"}],
      "in_progress": ["m2"],
      "frames": [
        {"kind": "tool_use", "agent": "lead", "agent_instance": "", "agent_label": "", "payload": {"id": "inst-coder", "name": "Agent", "input": {"subagent_type": "coder", "description": "[m2] Implement the limiter"}}, "created_at": "2026-09-19T11:55:00Z", "seq": 1},
        {"kind": "tool_use", "agent": "lead", "agent_instance": "", "agent_label": "", "payload": {"id": "inst-reviewer", "name": "Agent", "input": {"subagent_type": "reviewer", "description": "[m2] Review the limiter"}}, "created_at": "2026-09-19T11:56:00Z", "seq": 2},
        {"kind": "tool_use", "agent": "coder", "agent_instance": "inst-coder", "agent_label": "IGNORED-FRAME-LABEL", "payload": {"name": "Edit", "input": {"file_path": "api/limiter.go", "old_string": "x"}}, "created_at": "2026-09-19T11:58:00Z", "seq": 3},
        {"kind": "tool_use", "agent": "reviewer", "agent_instance": "inst-reviewer", "agent_label": "", "payload": {"name": "Read", "input": {"file_path": "api/limiter.go"}}, "created_at": "2026-09-19T11:59:00Z", "seq": 4}
      ],
      "expected": [
        {"milestone_id": "m2", "lanes": [
          {"agent": "reviewer", "agent_instance": "inst-reviewer", "agent_label": "Review the limiter", "tool": "Read", "detail": "api/limiter.go", "at": "2026-09-19T11:59:00Z"},
          {"agent": "coder", "agent_instance": "inst-coder", "agent_label": "Implement the limiter", "tool": "Edit", "detail": "api/limiter.go", "at": "2026-09-19T11:58:00Z"}
        ]}
      ]
    },
