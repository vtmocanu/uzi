      "seed": {
        "planning_claude_model": "opus",
        "planning_claude_effort": "high"
      },
      "body": {
        "default_effort": "low"
      },
      "expect": {
        "status": 200,
        "planning_claude_model": "opus",
        "planning_claude_effort": "high"
      }
    },
